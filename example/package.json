{
	"name": "rpc-example",
	"displayName": "rpc-example",
	"description": "",
	"version": "0.0.1",
	"engines": {
		"node": ">=24",
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onCommand:extension.openwebview",
		"onCommand:extension.sendMessage"
	],
	"main": "./out/extension",
	"contributes": {
		"commands": [
			{
				"command": "extension.openwebview",
				"title": "Open Webview"
			},
			{
				"command": "extension.sendMessage",
				"title": "Send Message to Webview"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"copy": "rimraf ./out/media && copyfiles -u 1 ./src/media/** ./out/"
	},
	"devDependencies": {
		"@types/node": "24.13.2",
		"@types/vscode": "1.100.0",
		"copyfiles": "2.4.1",
		"rimraf": "6.1.3",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"@sap-devx/webview-rpc": "file:.."
	}
}
